<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- parallel="methods" runs each test method in its own thread -->
<!-- thread-count="3" means 3 browsers open at the same time -->
<suite name="Suite" parallel="methods" thread-count="3">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Test">
        <classes>
            <class name="testcases.LaunchTest"/>
            <class name="testcases.LoginTest"/>
            <class name="testcases.NegativeLoginTest"/>
            <class name="testcases.DataDrivenLoginTest"/>
        </classes>
    </test>

</suite>